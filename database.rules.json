{
  "rules": {
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "attendance": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        },
        "payments": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        },
        "paymentHistory": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "payments": {
      "$paymentId": {
        ".read": "auth != null && (data.child('memberUid').val() == auth.uid || newData.child('memberUid').val() == auth.uid)",
        ".write": "auth != null && newData.child('memberUid').val() == auth.uid"
      }
    },
    "attendance": {
      "$memberId": {
        ".read": "auth != null && root.child('members').child(auth.uid).child('memberId').val() == $memberId",
        ".write": "auth != null && root.child('members').child(auth.uid).child('memberId').val() == $memberId"
      }
    },
    "notifications": {
      "$memberId": {
        ".read": "auth != null && root.child('members').child(auth.uid).child('memberId').val() == $memberId",
        ".write": "auth != null && root.child('members').child(auth.uid).child('memberId').val() == $memberId"
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() == auth.uid) || (data.exists() && data.child('userId').val() == auth.uid))"
      }
    }
  }
}
